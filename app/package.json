    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "~10.8.0",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "postcss-html": "^1.8.1",
